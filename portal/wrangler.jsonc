{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avkroken-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
