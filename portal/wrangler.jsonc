{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avkroken-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": true
  },
  "secrets_store_secrets": [
    {
      "binding": "AVKROKEN_DOCS_WEBHOOK_SECRET",
      "store_id": "293e79006fa649b8b182ef105a6b46d1",
      "secret_name": "AVKROKEN_DOCS_WEBHOOK_SECRET"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
