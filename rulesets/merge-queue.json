{
  "organization": {
    "owner": "Avkroken",
    "loose_required_status_checks": true,
    "main_ruleset_name": "main",
    "required_workflow": {
      "repository": ".github",
      "path": ".github/workflows/osv-scanner.yml"
    },
    "remove_required_status_checks": [
      "scan-pr / osv-scan"
    ]
  },
  "repositories": [
    ".github",
    "Bastion",
    "Docker-idempotent-update",
    "Dumpen",
    "Klarsprak",
    "Molnutbrott",
    "Pastebinit",
    "Politiker",
    "Produkter",
    "Regelverket",
    "Skvallerbyttan"
  ],
  "ruleset": {
    "name": "Avkroken merge queue",
    "target": "branch",
    "enforcement": "disabled",
    "bypass_actors": [],
    "conditions": {
      "ref_name": {
        "include": [
          "~DEFAULT_BRANCH"
        ],
        "exclude": []
      }
    },
    "rules": [
      {
        "type": "merge_queue",
        "parameters": {
          "check_response_timeout_minutes": 60,
          "grouping_strategy": "HEADGREEN",
          "max_entries_to_build": 5,
          "min_entries_to_merge": 1,
          "max_entries_to_merge": 1,
          "min_entries_to_merge_wait_minutes": 0,
          "merge_method": "SQUASH"
        }
      }
    ]
  }
}
